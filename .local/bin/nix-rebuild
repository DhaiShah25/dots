#!/usr/bin/env bash

set -e

pushd ~/.config/nixos/

file=$(fd -e nix | fzf)
nvim "${file:-.}"

if git diff --quiet '*.nix'; then
    echo "No changes detected, exiting."
    popd
    exit 0
fi

alejandra . &>/dev/null \
  || ( alejandra . ; echo "formatting failed!" && exit 1)

git diff -U0 '*.nix'

echo "NixOS Rebuilding..."

nh os switch

current=$(nh os info | grep current | cut -d' ' -f1)

read -r -p "Enter commit message (Leave blank for Default [Nix Generation: $current]): " user_msg

if [ -z "$user_msg" ]; then
    commit_msg="Nix Generation: $current"
else
    commit_msg="$user_msg"
fi

git add '*.nix'

if git diff --cached --quiet; then
    echo "No .nix files were modified to commit."
else
    git commit -m "$commit_msg"
fi

popd

notify-send -e "NixOS Rebuilt OK!"
